# ==========================================================================
# Event poster upload folder - security rules
# Folder: uploads/event_posters/
# This module only ever stores JPEG / PNG / WebP images with names that are
# generated by the server. These rules add defence in depth so that nothing
# stored (or dropped) in this folder can ever run as a script.
# ==========================================================================

# 1. No directory listing - visitors cannot browse the folder
Options -Indexes

# 2. If PHP is running as an Apache module, switch the engine off here so
#    even a wrongly named file could not be executed.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# 3. Block script file types completely (these are never created by the
#    Event Management module, so nothing legitimate is blocked).
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|bash|asp|aspx|jsp|exe|htaccess)$">
    Require all denied
</FilesMatch>
